{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Python: 현재 파일 실행",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": ["${file}"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Python: 연습장 감시 모드 (저장 시 자동 실행)",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": ["${workspaceFolder}/run.py", "watch"],
            "isBackground": true,
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "dedicated",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Python: 연습장 실행",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": ["${workspaceFolder}/run.py"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "Python: 챕터 목록 보기",
            "type": "shell",
            "command": "${command:python.interpreterPath}",
            "args": ["${workspaceFolder}/run.py", "list"],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
